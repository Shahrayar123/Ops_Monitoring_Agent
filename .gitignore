.venv/
__pycache__/
*.pyc
.pytest_cache/
.env
logs/
secrets/*.env

# Local tooling state (Claude Code) — keep local, never commit.
.claude/

# Generated by inspect_data.py — cross-check CSVs, not source.
data_inspection/

# Real customer cluster data — large and confidential, never commit.
# The small synthetic demo data (data/sample/) IS committed.
data/bdaktprod/
data/Sample APIs data/
data/Service Status/
data/Alerts & Health Checks/

# Product backend: local dev database + uploaded tenant files.
backend/ops.db
backend/uploads/

# Accumulated breach + AI-analysis history (ai/breach_history.py). Contains real
# cluster detail like data/bdaktprod/, and being append-only it would conflict on
# every merge. Keep it local; copy it deliberately if you want to share it.
context/
