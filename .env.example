# Copy this file to `.env` and adjust as needed. `.env` itself is gitignored —
# never commit real credentials. Loaded once at backend startup by
# backend/app/core/config.py (pydantic settings; env var names are the UPPERCASE
# form of each field and are case-insensitive).
#
# EVERYTHING HERE HAS A SENSIBLE DEFAULT — the app runs with an empty .env.
# The only values you'd normally set for a real deployment are DATABASE_URL
# (point at PostgreSQL) and the admin credentials.
#
# NOT configured here: per-user LLM API keys, Ollama URL, model priority, and
# KPI refresh intervals. Those are set per-user inside the app (Settings page)
# and stored — secrets encrypted — in the database, never in this file.

# --- Database ---
# Default: a local SQLite file at backend/ops.db (zero setup, for dev).
# For production, point at PostgreSQL:
#   DATABASE_URL=postgresql+psycopg://ops:secret@localhost:5432/ops_monitoring
# DATABASE_URL=

# --- Secrets (auto-generated on first run if left empty) ---
# SECRET_KEY signs the JWT access/refresh tokens.
# ENCRYPTION_KEY (Fernet) encrypts stored API keys and CM passwords at rest.
# If either is empty at startup, a strong value is generated and APPENDED to
# .env automatically. Do NOT rotate casually: changing SECRET_KEY invalidates
# every session; changing ENCRYPTION_KEY makes already-stored secrets
# undecryptable. Set them explicitly in production and keep them stable.
# SECRET_KEY=
# ENCRYPTION_KEY=

# --- Token lifetimes ---
# ACCESS_TOKEN_MINUTES=30
# REFRESH_TOKEN_DAYS=7

# --- First-run admin (created by `python -m backend.app.seed`) ---
# email-validator rejects reserved TLDs like .local, so use a real domain.
# CHANGE THE PASSWORD IMMEDIATELY in any real deployment.
ADMIN_EMAIL=admin@blutechconsulting.com
ADMIN_PASSWORD=ChangeMe!123

# --- Logging (see backend/app/core/logging_config.py) ---
# INFO | DEBUG | WARNING | ERROR. Logs go to logs/app.log + logs/errors.log
# (JSON, daily rotation, 7-day retention).
# LOG_LEVEL=INFO

# --- CORS (browser origins allowed to call the API) ---
# Only needed if the frontend is served from a different origin than the default
# Vite dev server. Must be valid JSON (a list of strings).
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Frontend base URL (used to build invite links in emails) ---
# APP_BASE_URL=http://localhost:5173

# --- SMTP for invite + password-reset emails (OPTIONAL) ---
# If these are set, admin-created users are emailed an invite, admin password
# resets are also emailed, and the self-service "Forgot password?" flow works
# (it can ONLY deliver by email — without SMTP it's a no-op and the admin "Reset
# password" action, which shows the temp password on screen, is the fallback).
# Invites and admin resets still work without SMTP (credentials shown on screen).
#
# Recommended provider: Resend (https://resend.com) via its SMTP endpoint — no
# extra dependency, just the values below. Verify your sending domain in the
# Resend dashboard (add their SPF/DKIM DNS records) or mail will land in spam /
# only deliver to your own address in test mode. SMTP_PASSWORD is the Resend API
# key; SMTP_USERNAME is the literal string "resend".
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USERNAME=resend
# SMTP_PASSWORD=re_your_resend_api_key
# SMTP_FROM=no-reply@yourverifieddomain.com
# SMTP_USE_TLS=true
